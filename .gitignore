# Never commit credentials or a full settings file (it carries API keys)
settings.json
settings.local.json
.claude.json
*.key
.env
.env.*

# Claude Code worktrees live inside the repo; never track or publish them
.claude/worktrees/

# Files that name the owner's private research; never committed
*.private.md
# The owner's private working files live here, never tracked
private/

# Handover notes belong in ~/.claude/handover/, never in a repo
.claude/handover/
