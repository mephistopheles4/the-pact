// --- call log ---------------------------------------------------------------

function log(exit) {
  const file = process.env.GH_CALL_LOG;
  if (!file) return;
  try {
    appendFileSync(file, JSON.stringify({ at: new Date().toISOString(), argv, exit }) + '\n');
  } catch {
    // An unwritable log never changes the answer.
  }
}

function finish(out, code = 0) {
  if (out !== undefined && out !== null) {
    process.stdout.write(typeof out === 'string' ? (out.endsWith('\n') ? out : out + '\n') : JSON.stringify(out, null, 2) + '\n');
  }
  log(code);
  process.exit(code);
}

function refuse(message = 'not available in this sandbox') {
  process.stderr.write(`gh: ${message}\n`);
  log(1);
  process.exit(1);
}

// --- argument parsing --------------------------------------------------------

const VALUE_FLAGS = new Set([
  '-R', '--repo', '--json', '-q', '--jq', '-t', '--template', '-f', '-F',
  '--field', '--raw-field', '-H', '--header', '-X', '--method', '-L', '--limit',
  '-s', '--state', '-l', '--label', '-S', '--search', '--input', '-A',
  '--author', '-a', '--assignee', '--color', '-B', '--base', '--hostname',
  '-p', '--project', '-m', '--milestone', '--app', '--mention',
]);

function parse(args) {
  const pos = [];
  const flags = {};
  const fields = {};
  for (let i = 0; i < args.length; i += 1) {
    let a = args[i];
    let v;
    if (a.startsWith('--') && a.includes('=')) {
      [a, v] = [a.slice(0, a.indexOf('=')), a.slice(a.indexOf('=') + 1)];
    } else if (/^-[A-Za-z]./.test(a) && VALUE_FLAGS.has(a.slice(0, 2))) {
      // A short flag with its value attached, such as -XPOST.
      [a, v] = [a.slice(0, 2), a.slice(2).replace(/^=/, '')];
    } else if (VALUE_FLAGS.has(a)) {
      v = args[i + 1];
      i += 1;
    } else if (a.startsWith('-')) {
      flags[a] = true;
      continue;
    } else {
      pos.push(a);
      continue;
    }
    if (['-f', '-F', '--field', '--raw-field'].includes(a)) {
      const eq = (v ?? '').indexOf('=');
      const key = eq < 0 ? v : v.slice(0, eq);
      let val = eq < 0 ? '' : v.slice(eq + 1);
      if ((a === '-F' || a === '--field') && val.startsWith('@')) {
        try { val = readFileSync(val === '@-' ? 0 : val.slice(1), 'utf8'); } catch { refuse(`could not read ${val}`); }
      }
      fields[key] = val;
    } else {
      flags[a] = v;
    }
  }
  return { pos, flags, fields };
}

const { pos, flags, fields } = parse(argv);
const jsonFields = typeof flags['--json'] === 'string' ? flags['--json'].split(',').map((s) => s.trim()).filter(Boolean) : null;
const filtering = flags['--jq'] ?? flags['-q'] ?? flags['--template'] ?? flags['-t'];
if (typeof filtering === 'string') {
  process.stderr.write('gh: --jq and --template are not supported here; printing the full JSON\n');
}
const repoFlag = flags['-R'] ?? flags['--repo'];
if (typeof repoFlag === 'string' && !/(^|\/)uploader$/.test(repoFlag)) {
  refuse(`could not resolve to a repository with the name '${repoFlag}'`);
}

