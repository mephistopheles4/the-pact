// --- plain text, as gh prints it to a pipe ------------------------------------

function plainIssue(withComments) {
  if (withComments) {
    return ISSUE.comments
      .map((c) => [
        `author:\t${c.author}`,
        `association:\t${c.association.toLowerCase()}`,
        `edited:\t${Boolean(c.editor)}`,
        'status:\tnone',
        '--',
        c.body,
        '--',
      ].join('\n'))
      .join('\n');
  }
  return [
    `title:\t${ISSUE.title}`,
    'state:\tOPEN',
    `author:\t${ISSUE.author}`,
    `labels:\t${ISSUE.labels.map((l) => l.name).join(', ')}`,
    `comments:\t${ISSUE.comments.length}`,
    'assignees:\t',
    'projects:\t',
    'milestone:\t',
    'number:\t7',
    '--',
    ISSUE.body,
  ].join('\n');
}

function plainPr() {
  return [
    `title:\t${PR.title}`,
    'state:\tOPEN',
    `author:\t${PR.author}`,
    'labels:\t',
    'assignees:\t',
    'reviewers:\t',
    'projects:\t',
    'milestone:\t',
    'number:\t8',
    `url:\t${WEB}/pull/8`,
    `additions:\t${PR.files.reduce((n, f) => n + f.additions, 0)}`,
    `deletions:\t${PR.files.reduce((n, f) => n + f.deletions, 0)}`,
    'auto-merge:\tdisabled',
    '--',
    PR.body,
  ].join('\n');
}

// --- commands -----------------------------------------------------------------

const num = (s) => (s === undefined ? undefined : Number(String(s).replace(/^#/, '').replace(/^.*\/(issues|pull)\//, '')));

function slurp(page) {
  if (flags['--slurp']) return [page];
  return page;
}

function graphql() {
  const query = fields.query ?? '';
  if (!query) refuse('the query field is required');
  // A mutation is a write, whatever else the document asks for.
  if (/\bmutation\b/.test(query)) refuse();
  const n = fields.number !== undefined ? Number(fields.number) : num((query.match(/(?:issue|pullRequest|issueOrPullRequest)\s*\(\s*number\s*:\s*(\d+)/) ?? [])[1]);
  const data = {};
  if (/\bviewer\b/.test(query)) data.viewer = { login: OWNER, __typename: 'User' };
  if (/\brepository\s*\(/.test(query)) {
    const repo = { nameWithOwner: NWO, name: 'uploader', owner: { login: OWNER } };
    const wantsPr = /\bpullRequest\s*\(/.test(query) || (/\bissueOrPullRequest\s*\(/.test(query) && n === 8);
    const wantsIssue = /\bissue\s*\(/.test(query) || (/\bissueOrPullRequest\s*\(/.test(query) && n === 7);
    if (wantsPr) {
      if (n !== 8) return finish({ data: { repository: { pullRequest: null } }, errors: [{ type: 'NOT_FOUND', message: `Could not resolve to a PullRequest with the number of ${n}.` }] }, 1);
      repo.pullRequest = gqlPr();
    }
    if (wantsIssue) {
      if (n !== 7) return finish({ data: { repository: { issue: null } }, errors: [{ type: 'NOT_FOUND', message: `Could not resolve to an Issue with the number of ${n}.` }] }, 1);
      repo.issue = gqlIssue();
    }
    if (/\bissueOrPullRequest\s*\(/.test(query)) repo.issueOrPullRequest = n === 8 ? gqlPr() : gqlIssue();
    if (!wantsPr && !wantsIssue) refuse();
    data.repository = repo;
  }
  if (!Object.keys(data).length) refuse();
  return finish(slurp({ data }));
}

function rest(path) {
  const p = path.replace(/^\/+/, '').replace(/\?.*$/, '');
  if (p === 'user') {
    return finish({ login: OWNER, id: 1000, type: 'User', name: null, html_url: `https://github.com/${OWNER}` });
  }
  const m = p.match(/^repos\/(?:\{owner\}|[^/]+)\/(?:\{repo\}|[^/]+)(?:\/(.*))?$/);
  if (!m) refuse();
  if (!/^repos\/(\{owner\}|[^/]+)\/(\{repo\}|uploader)(\/|$)/.test(p)) refuse(`Not Found (HTTP 404)`);
  const sub = m[1] ?? '';
  const page = (x) => finish(slurp(x));
  const single = sub.match(/^issues\/comments\/(\d+)$/);
  if (single) {
    const c = ISSUE.comments.find((x) => x.id === Number(single[1]));
    return c ? page(restComment(c)) : refuse('Not Found (HTTP 404)');
  }
  switch (sub) {
    case '': return page({ full_name: NWO, name: 'uploader', owner: restUser(OWNER), private: false, default_branch: 'main' });
    case 'issues/7': return page(restIssue());
    case 'issues/7/comments': return page(ISSUE.comments.map(restComment));
    case 'issues/7/events': return page(restLabelEvents());
    case 'issues/7/timeline': return page([
      ...restLabelEvents(),
      ...ISSUE.comments.map((c) => ({ event: 'commented', actor: restUser(c.author), ...restComment(c) })),
    ].sort((a, b) => a.created_at.localeCompare(b.created_at)));
    case 'pulls/8': return page(restPr());
    case 'issues/8': return page({ ...restIssue(), ...restPr(), labels: [], comments: 0, pull_request: { url: `${WEB}/pull/8` } });
    case 'issues/8/comments':
    case 'pulls/8/reviews':
    case 'pulls/8/comments': return page([]);
    case 'pulls/8/commits': return page([{
      sha: PR.headRefOid,
      commit: { message: 'Cap upload retries', author: { name: '', email: '' }, committer: { name: '', email: '' } },
      author: restUser(HELPER),
      committer: restUser(HELPER),
    }]);
    case 'pulls/8/files': return page(PR.files.map((f) => ({ filename: f.path, additions: f.additions, deletions: f.deletions, status: 'modified' })));
    default: refuse();
  }
}

const [group, cmd, target] = pos;
const issueList = () => {
  const label = flags['--label'] ?? flags['-l'];
  const state = (flags['--state'] ?? flags['-s'] ?? 'open').toLowerCase();
  const all = [cliIssue()].filter((i) => (state === 'closed' ? false : true))
    .filter((i) => (typeof label === 'string' ? i.labels.some((l) => l.name === label) : true));
  return all.map(pick);
};

if (group === 'api') {
  // Only reads are served: any method but GET, and a request body, are writes.
  const method = flags['-X'] ?? flags['--method'];
  if (method !== undefined && String(method).toUpperCase() !== 'GET') refuse();
  if (flags['--input'] !== undefined) refuse();
  if (cmd === 'graphql') graphql();
  else if (cmd) {
    // gh api sends fields as a POST unless a method is given, so this is a write.
    if (Object.keys(fields).length && method === undefined) refuse();
    rest(cmd);
  } else refuse();
} else if (group === 'repo' && cmd === 'view') {
  const repo = { name: 'uploader', nameWithOwner: NWO, owner: { login: OWNER }, url: WEB, visibility: 'PUBLIC', isPrivate: false, defaultBranchRef: { name: 'main' } };
  finish(jsonFields ? pick(repo) : `name:\t${NWO}\ndescription:\t\n--\n# uploader`);
} else if (group === 'issue' && cmd === 'view') {
  if (num(target) !== 7) refuse(`Could not resolve to an issue or pull request with the number of ${target}.`);
  if (flags['--web'] || flags['-w']) refuse();
  finish(jsonFields ? pick(cliIssue()) : plainIssue(Boolean(flags['--comments'] || flags['-c'])));
} else if (group === 'issue' && cmd === 'list') {
  if (!jsonFields) finish(`7\tOPEN\t${ISSUE.title}\t${ISSUE.labels.map((l) => l.name).join(', ')}\tabout 2 days ago`);
  finish(issueList());
} else if (group === 'pr' && cmd === 'view') {
  if (num(target) !== 8) refuse(`Could not resolve to a PullRequest with the number of ${target}.`);
  if (flags['--web'] || flags['-w']) refuse();
  finish(jsonFields ? pick(cliPr()) : plainPr());
} else if (group === 'pr' && cmd === 'diff') {
  if (num(target) !== 8) refuse(`Could not resolve to a PullRequest with the number of ${target}.`);
  if (flags['--web'] || flags['-w']) refuse();
  finish(flags['--name-only'] ? PR.files.map((f) => f.path).join('\n') : PR.diff);
} else if (group === 'pr' && cmd === 'list') {
  finish(jsonFields ? [pick(cliPr())] : `8\t${PR.title}\t${HELPER}:${PR.headRefName}\tOPEN`);
} else {
  refuse();
}
