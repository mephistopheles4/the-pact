const pick = (record) => {
  if (!jsonFields) return record;
  const out = {};
  for (const f of jsonFields) if (f in record) out[f] = record[f];
  return out;
};

function gqlEdits(item) {
  return item.editor
    ? { totalCount: 1, nodes: [{ editedAt: item.editedAt, editor: gqlActor(item.editor) }] }
    : { totalCount: 0, nodes: [] };
}

function gqlComment(c) {
  return {
    id: `IC_kwDOSB${c.id}`,
    databaseId: c.id,
    url: commentUrl(c),
    author: gqlActor(c.author),
    authorAssociation: c.association,
    viewerDidAuthor: c.author === OWNER,
    editor: c.editor ? gqlActor(c.editor) : null,
    lastEditedAt: c.editedAt ?? null,
    includesCreatedEdit: Boolean(c.editor),
    userContentEdits: gqlEdits(c),
    createdAt: c.createdAt,
    updatedAt: lastUpdate(c),
    isMinimized: false,
    minimizedReason: null,
    body: c.body,
  };
}

